          <xs:field xpath="Cliente_SK" />
        </xs:keyref>
        <xs:keyref name="FK_Fact_Ventas_Dim_Empleado" refer="Constraint_Dim_Empleado">
          <xs:selector xpath=".//dbo_Fact_Ventas" />
          <xs:field xpath="Empleado_SK" />
        </xs:keyref>
        <xs:keyref name="FK_Fact_Ventas_Dim_Producto" refer="Constraint_Dim_Producto">
          <xs:selector xpath=".//dbo_Fact_Ventas" />
          <xs:field xpath="Producto_SK" />
        </xs:keyref>
        <xs:keyref name="FK_Fact_Ventas_Dim_Sucursal" refer="Constraint_Dim_Sucursal">
          <xs:selector xpath=".//dbo_Fact_Ventas" />
          <xs:field xpath="Sucursal_SK" />
        </xs:keyref>

        <SQLTask:SqlTaskData
          SQLTask:Connection="{2E54D1CB-6DFD-4478-A01D-6FF83BA283E9}"
          SQLTask:SqlStatementSource="IF NOT EXISTS (SELECT 1 FROM dbo.Dim_Cliente WHERE Cliente_SK = -1 AND Cliente_BK = -1)&#xA;BEGIN&#xA;    THROW 51000, 'Falta el miembro desconocido -1.', 1;&#xA;END;&#xA;&#xA;IF EXISTS (SELECT 1 FROM dbo.Dim_Cliente GROUP BY Cliente_BK HAVING COUNT(*) &gt; 1)&#xA;BEGIN&#xA;    THROW 51000, 'Claves de negocio duplicadas en destino.', 1;&#xA;END;&#xA;&#xA;IF EXISTS (&#xA;    SELECT e.cliente_id,&#xA;           CAST(LTRIM(RTRIM(COALESCE(e.nombre, N''))) + N' ' + LTRIM(RTRIM(COALESCE(e.appaterno, N''))) + CASE WHEN NULLIF(LTRIM(RTRIM(e.apmaterno)), N'') IS NULL THEN N'' ELSE N' ' + LTRIM(RTRIM(e.apmaterno)) END AS varchar(150)) COLLATE DATABASE_DEFAULT,&#xA;           CAST(CASE WHEN UPPER(LTRIM(RTRIM(e.sexo))) = 'M' THEN 'Masculino' WHEN UPPER(LTRIM(RTRIM(e.sexo))) = 'F' THEN 'Femenino' ELSE 'No Informado' END AS varchar(20)) COLLATE DATABASE_DEFAULT,&#xA;           CAST(e.fecha_nacimiento AS date),&#xA;           CAST(COALESCE(NULLIF(LTRIM(RTRIM(e.estado_civil)), N''), N'No Informado') AS varchar(50)) COLLATE DATABASE_DEFAULT&#xA;    FROM Albarran.dbo.clientes e&#xA;    EXCEPT&#xA;    SELECT Cliente_BK,&#xA;           Nombre_Completo COLLATE DATABASE_DEFAULT,&#xA;           Sexo COLLATE DATABASE_DEFAULT,&#xA;           Fecha_Nacimiento,&#xA;           Estado_Civil COLLATE DATABASE_DEFAULT&#xA;    FROM dbo.Dim_Cliente WHERE Cliente_SK &lt;&gt; -1&#xA;) OR EXISTS (&#xA;    SELECT Cliente_BK,&#xA;           Nombre_Completo COLLATE DATABASE_DEFAULT,&#xA;           Sexo COLLATE DATABASE_DEFAULT,&#xA;           Fecha_Nacimiento,&#xA;           Estado_Civil COLLATE DATABASE_DEFAULT&#xA;    FROM dbo.Dim_Cliente WHERE Cliente_SK &lt;&gt; -1&#xA;    EXCEPT&#xA;    SELECT e.cliente_id,&#xA;           CAST(LTRIM(RTRIM(COALESCE(e.nombre, N''))) + N' ' + LTRIM(RTRIM(COALESCE(e.appaterno, N''))) + CASE WHEN NULLIF(LTRIM(RTRIM(e.apmaterno)), N'') IS NULL THEN N'' ELSE N' ' + LTRIM(RTRIM(e.apmaterno)) END AS varchar(150)) COLLATE DATABASE_DEFAULT,&#xA;           CAST(CASE WHEN UPPER(LTRIM(RTRIM(e.sexo))) = 'M' THEN 'Masculino' WHEN UPPER(LTRIM(RTRIM(e.sexo))) = 'F' THEN 'Femenino' ELSE 'No Informado' END AS varchar(20)) COLLATE DATABASE_DEFAULT,&#xA;           CAST(e.fecha_nacimiento AS date),&#xA;           CAST(COALESCE(NULLIF(LTRIM(RTRIM(e.estado_civil)), N''), N'No Informado') AS varchar(50)) COLLATE DATABASE_DEFAULT&#xA;    FROM Albarran.dbo.clientes e&#xA;)&#xA;BEGIN&#xA;    THROW 51000, 'La dimension no coincide con la transformacion del origen.', 1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>

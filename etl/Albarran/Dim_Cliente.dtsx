      DTS:LocaleID="-1"
      DTS:ObjectName="01 Validar Origen"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9BC08A2B-FC00-46CF-AA77-8755585300A8}"
          SQLTask:SqlStatementSource="IF EXISTS (SELECT 1 FROM dbo.clientes GROUP BY cliente_id HAVING COUNT(*) &gt; 1)&#xA;BEGIN&#xA;    THROW 51000, 'Cliente duplicado en origen.', 1;&#xA;END;&#xA;&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM dbo.clientes e&#xA;    WHERE e.cliente_id IS NULL&#xA;       OR e.cliente_id = -1&#xA;       OR NULLIF(LTRIM(RTRIM(e.nombre)), N'') IS NULL&#xA;       OR NULLIF(LTRIM(RTRIM(e.appaterno)), N'') IS NULL&#xA;       OR LEN(LTRIM(RTRIM(COALESCE(e.nombre, N''))) + N' ' + LTRIM(RTRIM(COALESCE(e.appaterno, N''))) + CASE WHEN NULLIF(LTRIM(RTRIM(e.apmaterno)), N'') IS NULL THEN N'' ELSE N' ' + LTRIM(RTRIM(e.apmaterno)) END) &gt; 150&#xA;       OR LEN(e.estado_civil) &gt; 50&#xA;)&#xA;BEGIN&#xA;    THROW 51000, 'Cliente o textos fuera de los limites del destino.', 1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

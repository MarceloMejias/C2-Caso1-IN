    <DTS:Executable
      DTS:refId="Package\03 Validar Hechos"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3E6A1C88-4D91-42D1-9E14-1C8A77E20003}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="03 Validar Hechos"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2E54D1CB-6DFD-4478-A01D-6FF83BA283E9}"
          SQLTask:SqlStatementSource="IF EXISTS (&#xA;    SELECT Fecha_SK, Cliente_SK, Empleado_SK, Producto_SK, Sucursal_SK, Venta_ID, Cantidad, Precio_Unitario, Monto_Bruto, Porcentaje_Descuento, Monto_Descuento, Monto_Neto, COUNT_BIG(*) AS Repeticiones&#xA;    FROM (&#xA;        SELECT ISNULL(t.Fecha_SK, -1) AS Fecha_SK,&#xA;               ISNULL(c.Cliente_SK, -1) AS Cliente_SK,&#xA;               ISNULL(e.Empleado_SK, -1) AS Empleado_SK,&#xA;               ISNULL(p.Producto_SK, -1) AS Producto_SK,&#xA;               ISNULL(s.Sucursal_SK, -1) AS Sucursal_SK,&#xA;               v.venta_id AS Venta_ID,&#xA;               d.cantidad AS Cantidad,&#xA;               CAST(d.precio_unitario AS numeric(12,2)) AS Precio_Unitario,&#xA;               m.Monto_Bruto,&#xA;               CAST(d.descuento AS numeric(5,4)) AS Porcentaje_Descuento,&#xA;               x.Monto_Descuento,&#xA;               CAST(m.Monto_Bruto - x.Monto_Descuento AS numeric(14,2)) AS Monto_Neto&#xA;        FROM Albarran.dbo.ventas v&#xA;        JOIN Albarran.dbo.detalle_ventas d ON d.venta_id = v.venta_id&#xA;        LEFT JOIN dbo.Dim_Cliente c ON c.Cliente_BK = v.cliente_id&#xA;        LEFT JOIN dbo.Dim_Empleado e ON e.Empleado_BK = v.vendedor_id&#xA;        LEFT JOIN dbo.Dim_Producto p ON p.Producto_BK = d.producto_id&#xA;        LEFT JOIN dbo.Dim_Sucursal s ON s.Sucursal_BK = v.sucursal_id&#xA;        LEFT JOIN dbo.Dim_Tiempo t ON t.Fecha_SK = CONVERT(int, CONVERT(char(8), v.fecha, 112))&#xA;        CROSS APPLY (SELECT CAST(CAST(d.cantidad AS decimal(20,0)) * CAST(d.precio_unitario AS decimal(12,2)) AS numeric(14,2)) AS Monto_Bruto) m&#xA;        CROSS APPLY (SELECT CAST(m.Monto_Bruto * CAST(d.descuento AS numeric(5,4)) AS numeric(14,2)) AS Monto_Descuento) x&#xA;    ) esperado&#xA;    GROUP BY Fecha_SK, Cliente_SK, Empleado_SK, Producto_SK, Sucursal_SK, Venta_ID, Cantidad, Precio_Unitario, Monto_Bruto, Porcentaje_Descuento, Monto_Descuento, Monto_Neto&#xA;    EXCEPT&#xA;    SELECT Fecha_SK, Cliente_SK, Empleado_SK, Producto_SK, Sucursal_SK, Venta_ID, Cantidad, Precio_Unitario, Monto_Bruto, Porcentaje_Descuento, Monto_Descuento, Monto_Neto, COUNT_BIG(*)&#xA;    FROM dbo.Fact_Ventas&#xA;    GROUP BY Fecha_SK, Cliente_SK, Empleado_SK, Producto_SK, Sucursal_SK, Venta_ID, Cantidad, Precio_Unitario, Monto_Bruto, Porcentaje_Descuento, Monto_Descuento, Monto_Neto&#xA;) OR EXISTS (&#xA;    SELECT Fecha_SK, Cliente_SK, Empleado_SK, Producto_SK, Sucursal_SK, Venta_ID, Cantidad, Precio_Unitario, Monto_Bruto, Porcentaje_Descuento, Monto_Descuento, Monto_Neto, COUNT_BIG(*)&#xA;    FROM dbo.Fact_Ventas&#xA;    GROUP BY Fecha_SK, Cliente_SK, Empleado_SK, Producto_SK, Sucursal_SK, Venta_ID, Cantidad, Precio_Unitario, Monto_Bruto, Porcentaje_Descuento, Monto_Descuento, Monto_Neto&#xA;    EXCEPT&#xA;    SELECT Fecha_SK, Cliente_SK, Empleado_SK, Producto_SK, Sucursal_SK, Venta_ID, Cantidad, Precio_Unitario, Monto_Bruto, Porcentaje_Descuento, Monto_Descuento, Monto_Neto, COUNT_BIG(*) AS Repeticiones&#xA;    FROM (&#xA;        SELECT ISNULL(t.Fecha_SK, -1) AS Fecha_SK,&#xA;               ISNULL(c.Cliente_SK, -1) AS Cliente_SK,&#xA;               ISNULL(e.Empleado_SK, -1) AS Empleado_SK,&#xA;               ISNULL(p.Producto_SK, -1) AS Producto_SK,&#xA;               ISNULL(s.Sucursal_SK, -1) AS Sucursal_SK,&#xA;               v.venta_id AS Venta_ID,&#xA;               d.cantidad AS Cantidad,&#xA;               CAST(d.precio_unitario AS numeric(12,2)) AS Precio_Unitario,&#xA;               m.Monto_Bruto,&#xA;               CAST(d.descuento AS numeric(5,4)) AS Porcentaje_Descuento,&#xA;               x.Monto_Descuento,&#xA;               CAST(m.Monto_Bruto - x.Monto_Descuento AS numeric(14,2)) AS Monto_Neto&#xA;        FROM Albarran.dbo.ventas v&#xA;        JOIN Albarran.dbo.detalle_ventas d ON d.venta_id = v.venta_id&#xA;        LEFT JOIN dbo.Dim_Cliente c ON c.Cliente_BK = v.cliente_id&#xA;        LEFT JOIN dbo.Dim_Empleado e ON e.Empleado_BK = v.vendedor_id&#xA;        LEFT JOIN dbo.Dim_Producto p ON p.Producto_BK = d.producto_id&#xA;        LEFT JOIN dbo.Dim_Sucursal s ON s.Sucursal_BK = v.sucursal_id&#xA;        LEFT JOIN dbo.Dim_Tiempo t ON t.Fecha_SK = CONVERT(int, CONVERT(char(8), v.fecha, 112))&#xA;        CROSS APPLY (SELECT CAST(CAST(d.cantidad AS decimal(20,0)) * CAST(d.precio_unitario AS decimal(12,2)) AS numeric(14,2)) AS Monto_Bruto) m&#xA;        CROSS APPLY (SELECT CAST(m.Monto_Bruto * CAST(d.descuento AS numeric(5,4)) AS numeric(14,2)) AS Monto_Descuento) x&#xA;    ) esperado&#xA;    GROUP BY Fecha_SK, Cliente_SK, Empleado_SK, Producto_SK, Sucursal_SK, Venta_ID, Cantidad, Precio_Unitario, Monto_Bruto, Porcentaje_Descuento, Monto_Descuento, Monto_Neto&#xA;)&#xA;BEGIN&#xA;    THROW 51000, 'Fact_Ventas difiere del origen: filas, claves, importes o multiplicidad.', 1;&#xA;END;&#xA;&#xA;IF EXISTS (&#xA;    SELECT 1 FROM dbo.Fact_Ventas f&#xA;    LEFT JOIN dbo.Dim_Cliente c ON c.Cliente_SK = f.Cliente_SK&#xA;    LEFT JOIN dbo.Dim_Empleado e ON e.Empleado_SK = f.Empleado_SK&#xA;    LEFT JOIN dbo.Dim_Producto p ON p.Producto_SK = f.Producto_SK&#xA;    LEFT JOIN dbo.Dim_Sucursal s ON s.Sucursal_SK = f.Sucursal_SK&#xA;    LEFT JOIN dbo.Dim_Tiempo t ON t.Fecha_SK = f.Fecha_SK&#xA;    WHERE c.Cliente_SK IS NULL OR e.Empleado_SK IS NULL OR p.Producto_SK IS NULL OR s.Sucursal_SK IS NULL OR t.Fecha_SK IS NULL&#xA;)&#xA;BEGIN&#xA;    THROW 51000, 'Clave dimensional huerfana en Fact_Ventas.', 1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>

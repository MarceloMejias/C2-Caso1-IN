    <DTS:Executable
      DTS:refId="Package\01 Validar Origen"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3E6A1C88-4D91-42D1-9E14-1C8A77E20001}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="01 Validar Origen"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9BC08A2B-FC00-46CF-AA77-8755585300A8}"
          SQLTask:SqlStatementSource="IF EXISTS (SELECT 1 FROM dbo.ventas GROUP BY venta_id HAVING COUNT(*) &gt; 1)&#xA;BEGIN&#xA;    THROW 51000, 'ID de venta duplicado en origen.', 1;&#xA;END;&#xA;&#xA;IF EXISTS (SELECT 1 FROM dbo.detalle_ventas GROUP BY venta_id, producto_id HAVING COUNT(*) &gt; 1)&#xA;BEGIN&#xA;    THROW 51000, 'Grano venta/producto repetido; revisar antes de cargar.', 1;&#xA;END;&#xA;&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM dbo.detalle_ventas d&#xA;    LEFT JOIN dbo.ventas v ON v.venta_id = d.venta_id&#xA;    WHERE v.venta_id IS NULL&#xA;       OR d.cantidad IS NULL&#xA;       OR d.cantidad &lt;= 0&#xA;       OR d.precio_unitario IS NULL&#xA;       OR d.precio_unitario &lt; 0&#xA;       OR d.descuento IS NULL&#xA;       OR d.descuento &lt; 0&#xA;       OR d.descuento &gt; 1&#xA;       OR TRY_CONVERT(numeric(14,2), CAST(d.cantidad AS decimal(20,0)) * CAST(d.precio_unitario AS decimal(12,2))) IS NULL&#xA;)&#xA;BEGIN&#xA;    THROW 51000, 'Detalle huerfano, cantidad, precio, descuento o monto invalido.', 1;&#xA;END;&#xA;&#xA;IF EXISTS (SELECT 1 FROM dbo.ventas v WHERE NOT EXISTS (SELECT 1 FROM dbo.detalle_ventas d WHERE d.venta_id = v.venta_id))&#xA;BEGIN&#xA;    THROW 51000, 'Hay ventas sin detalle; resolver antes de cargar.', 1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

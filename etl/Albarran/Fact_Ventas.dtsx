            <component
              refId="Package\02 Cargar Fact_Ventas\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">DECLARE @Cargar bit = CASE WHEN EXISTS(SELECT 1 FROM Albarran_DW.dbo.Fact_Ventas) THEN 0 ELSE 1 END;
SELECT ISNULL(t.Fecha_SK, -1) AS Fecha_SK,
 ISNULL(c.Cliente_SK, -1) AS Cliente_SK,
 ISNULL(e.Empleado_SK, -1) AS Empleado_SK,
 ISNULL(p.Producto_SK, -1) AS Producto_SK,
 ISNULL(s.Sucursal_SK, -1) AS Sucursal_SK,
 v.venta_id AS Venta_ID,
 d.cantidad AS Cantidad,
 CAST(d.precio_unitario AS numeric(12,2)) AS Precio_Unitario,
 m.Monto_Bruto,
 CAST(d.descuento AS numeric(5,4)) AS Porcentaje_Descuento,
 x.Monto_Descuento,
 CAST(m.Monto_Bruto - x.Monto_Descuento AS numeric(14,2)) AS Monto_Neto
FROM dbo.ventas v
INNER JOIN dbo.detalle_ventas d ON d.venta_id = v.venta_id
LEFT JOIN Albarran_DW.dbo.Dim_Cliente c ON c.Cliente_BK = v.cliente_id
LEFT JOIN Albarran_DW.dbo.Dim_Empleado e ON e.Empleado_BK = v.vendedor_id
LEFT JOIN Albarran_DW.dbo.Dim_Producto p ON p.Producto_BK = d.producto_id
LEFT JOIN Albarran_DW.dbo.Dim_Sucursal s ON s.Sucursal_BK = v.sucursal_id
LEFT JOIN Albarran_DW.dbo.Dim_Tiempo t ON t.Fecha_SK = CONVERT(int, CONVERT(char(8), v.fecha, 112))
CROSS APPLY (SELECT CAST(CAST(d.cantidad AS decimal(20,0)) * CAST(d.precio_unitario AS decimal(12,2)) AS numeric(14,2)) AS Monto_Bruto) m
CROSS APPLY (SELECT CAST(m.Monto_Bruto * CAST(d.descuento AS numeric(5,4)) AS numeric(14,2)) AS Monto_Descuento) x
WHERE @Cargar = 1;</property>

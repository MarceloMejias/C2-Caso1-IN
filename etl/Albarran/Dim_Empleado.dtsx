        <SQLTask:SqlTaskData
          SQLTask:Connection="{2E54D1CB-6DFD-4478-A01D-6FF83BA283E9}"
          SQLTask:SqlStatementSource="IF NOT EXISTS (SELECT 1 FROM dbo.Dim_Empleado WHERE Empleado_SK = -1 AND Empleado_BK = -1)&#xA;BEGIN&#xA;    THROW 51000, 'Falta el miembro desconocido -1.', 1;&#xA;END;&#xA;&#xA;IF EXISTS (SELECT 1 FROM dbo.Dim_Empleado GROUP BY Empleado_BK HAVING COUNT(*) &gt; 1)&#xA;BEGIN&#xA;    THROW 51000, 'Claves de negocio duplicadas en destino.', 1;&#xA;END;&#xA;&#xA;IF EXISTS (&#xA;    SELECT e.empleado_id,&#xA;           CAST(LTRIM(RTRIM(COALESCE(e.nombre, N''))) + N' ' + LTRIM(RTRIM(COALESCE(e.appaterno, N''))) + CASE WHEN NULLIF(LTRIM(RTRIM(e.apmaterno)), N'') IS NULL THEN N'' ELSE N' ' + LTRIM(RTRIM(e.apmaterno)) END AS varchar(150)) COLLATE DATABASE_DEFAULT,&#xA;           CAST(UPPER(LTRIM(RTRIM(c.nombre))) AS varchar(100)) COLLATE DATABASE_DEFAULT,&#xA;           CAST(e.sueldo_base AS numeric(12,2)),&#xA;           CAST(e.fecha_contrato AS date)&#xA;    FROM Albarran.dbo.empleados e&#xA;    JOIN Albarran.dbo.cargos c ON c.cargo_id = e.cargo_id&#xA;    EXCEPT&#xA;    SELECT Empleado_BK,&#xA;           Nombre_Completo COLLATE DATABASE_DEFAULT,&#xA;           Nombre_Cargo COLLATE DATABASE_DEFAULT,&#xA;           Sueldo_Base,&#xA;           Fecha_Contrato&#xA;    FROM dbo.Dim_Empleado WHERE Empleado_SK &lt;&gt; -1&#xA;) OR EXISTS (&#xA;    SELECT Empleado_BK,&#xA;           Nombre_Completo COLLATE DATABASE_DEFAULT,&#xA;           Nombre_Cargo COLLATE DATABASE_DEFAULT,&#xA;           Sueldo_Base,&#xA;           Fecha_Contrato&#xA;    FROM dbo.Dim_Empleado WHERE Empleado_SK &lt;&gt; -1&#xA;    EXCEPT&#xA;    SELECT e.empleado_id,&#xA;           CAST(LTRIM(RTRIM(COALESCE(e.nombre, N''))) + N' ' + LTRIM(RTRIM(COALESCE(e.appaterno, N''))) + CASE WHEN NULLIF(LTRIM(RTRIM(e.apmaterno)), N'') IS NULL THEN N'' ELSE N' ' + LTRIM(RTRIM(e.apmaterno)) END AS varchar(150)) COLLATE DATABASE_DEFAULT,&#xA;           CAST(UPPER(LTRIM(RTRIM(c.nombre))) AS varchar(100)) COLLATE DATABASE_DEFAULT,&#xA;           CAST(e.sueldo_base AS numeric(12,2)),&#xA;           CAST(e.fecha_contrato AS date)&#xA;    FROM Albarran.dbo.empleados e&#xA;    JOIN Albarran.dbo.cargos c ON c.cargo_id = e.cargo_id&#xA;)&#xA;BEGIN&#xA;    THROW 51000, 'La dimension no coincide con la transformacion del origen.', 1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>

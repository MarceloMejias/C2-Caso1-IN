    <DTS:Executable
      DTS:refId="Package\01 Validar Origen"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3E6A1C88-4D91-42D1-9E12-1C8A77E20001}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="01 Validar Origen"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9BC08A2B-FC00-46CF-AA77-8755585300A8}"
          SQLTask:SqlStatementSource="IF EXISTS (SELECT 1 FROM dbo.empleados GROUP BY empleado_id HAVING COUNT(*) &gt; 1)&#xA;BEGIN&#xA;    THROW 51000, 'Empleado duplicado en origen.', 1;&#xA;END;&#xA;&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM dbo.empleados e&#xA;    LEFT JOIN dbo.cargos c ON c.cargo_id = e.cargo_id&#xA;    WHERE e.empleado_id IS NULL&#xA;       OR e.empleado_id = -1&#xA;       OR c.cargo_id IS NULL&#xA;       OR NULLIF(LTRIM(RTRIM(e.nombre)), N'') IS NULL&#xA;       OR NULLIF(LTRIM(RTRIM(e.appaterno)), N'') IS NULL&#xA;       OR LEN(LTRIM(RTRIM(COALESCE(e.nombre, N''))) + N' ' + LTRIM(RTRIM(COALESCE(e.appaterno, N''))) + CASE WHEN NULLIF(LTRIM(RTRIM(e.apmaterno)), N'') IS NULL THEN N'' ELSE N' ' + LTRIM(RTRIM(e.apmaterno)) END) &gt; 150&#xA;       OR NULLIF(LTRIM(RTRIM(c.nombre)), N'') IS NULL&#xA;       OR LEN(UPPER(LTRIM(RTRIM(c.nombre)))) &gt; 100&#xA;       OR e.sueldo_base &lt; 0&#xA;)&#xA;BEGIN&#xA;    THROW 51000, 'Empleado, nombre completo, cargo o sueldo invalido.', 1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

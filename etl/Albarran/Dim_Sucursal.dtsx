      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9BC08A2B-FC00-46CF-AA77-8755585300A8}"
          SQLTask:SqlStatementSource="IF EXISTS (SELECT 1 FROM dbo.sucursales GROUP BY sucursal_id HAVING COUNT(*) &gt; 1)&#xA;BEGIN&#xA;    THROW 51000, 'Sucursal duplicada en origen.', 1;&#xA;END;&#xA;&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM dbo.sucursales s&#xA;    LEFT JOIN dbo.comunas c ON c.comuna_id = s.comuna_id&#xA;    WHERE s.sucursal_id IS NULL&#xA;       OR s.sucursal_id = -1&#xA;       OR c.comuna_id IS NULL&#xA;       OR NULLIF(LTRIM(RTRIM(s.sucursal)), '') IS NULL&#xA;       OR NULLIF(LTRIM(RTRIM(c.comuna)), '') IS NULL&#xA;       OR LEN(s.sucursal) &gt; 100&#xA;       OR LEN(c.comuna) &gt; 100&#xA;)&#xA;BEGIN&#xA;    THROW 51000, 'Sucursal o comuna inexistente, vacia o demasiado larga.', 1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

        <SQLTask:SqlTaskData
          SQLTask:Connection="{2E54D1CB-6DFD-4478-A01D-6FF83BA283E9}"
          SQLTask:SqlStatementSource="IF NOT EXISTS (SELECT 1 FROM dbo.Dim_Producto WHERE Producto_SK = -1 AND Producto_BK = -1)&#xA;BEGIN&#xA;    THROW 51000, 'Falta el miembro desconocido -1.', 1;&#xA;END;&#xA;&#xA;IF EXISTS (SELECT 1 FROM dbo.Dim_Producto GROUP BY Producto_BK HAVING COUNT(*) &gt; 1)&#xA;BEGIN&#xA;    THROW 51000, 'Hay claves de negocio duplicadas.', 1;&#xA;END;&#xA;&#xA;IF EXISTS (&#xA;    SELECT p.producto_id,&#xA;           CAST(LTRIM(RTRIM(p.nombre)) AS varchar(100)) COLLATE DATABASE_DEFAULT,&#xA;           CAST(LTRIM(RTRIM(c.categoria)) AS varchar(100)) COLLATE DATABASE_DEFAULT,&#xA;           CAST(p.precio AS numeric(12,2)),&#xA;           CAST(COALESCE(p.descripcion, N'Sin descripción') AS varchar(255)) COLLATE DATABASE_DEFAULT&#xA;    FROM Albarran.dbo.productos p&#xA;    JOIN Albarran.dbo.categorias c ON c.categoria_id = p.categoria_id&#xA;    EXCEPT&#xA;    SELECT Producto_BK,&#xA;           Nombre_Producto COLLATE DATABASE_DEFAULT,&#xA;           Nombre_Categoria COLLATE DATABASE_DEFAULT,&#xA;           Precio_Catalogo,&#xA;           Descripcion COLLATE DATABASE_DEFAULT&#xA;    FROM dbo.Dim_Producto WHERE Producto_SK &lt;&gt; -1&#xA;) OR EXISTS (&#xA;    SELECT Producto_BK,&#xA;           Nombre_Producto COLLATE DATABASE_DEFAULT,&#xA;           Nombre_Categoria COLLATE DATABASE_DEFAULT,&#xA;           Precio_Catalogo,&#xA;           Descripcion COLLATE DATABASE_DEFAULT&#xA;    FROM dbo.Dim_Producto WHERE Producto_SK &lt;&gt; -1&#xA;    EXCEPT&#xA;    SELECT p.producto_id,&#xA;           CAST(LTRIM(RTRIM(p.nombre)) AS varchar(100)) COLLATE DATABASE_DEFAULT,&#xA;           CAST(LTRIM(RTRIM(c.categoria)) AS varchar(100)) COLLATE DATABASE_DEFAULT,&#xA;           CAST(p.precio AS numeric(12,2)),&#xA;           CAST(COALESCE(p.descripcion, N'Sin descripción') AS varchar(255)) COLLATE DATABASE_DEFAULT&#xA;    FROM Albarran.dbo.productos p&#xA;    JOIN Albarran.dbo.categorias c ON c.categoria_id = p.categoria_id&#xA;)&#xA;BEGIN&#xA;    THROW 51000, 'La dimension no coincide con productos y categorias del origen.', 1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>

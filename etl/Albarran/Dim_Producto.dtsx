      DTS:ObjectName="01 Validar Origen"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9BC08A2B-FC00-46CF-AA77-8755585300A8}"
          SQLTask:SqlStatementSource="IF EXISTS (SELECT 1 FROM dbo.productos GROUP BY producto_id HAVING COUNT(*) &gt; 1)&#xA;BEGIN&#xA;    THROW 51000, 'Producto duplicado en origen.', 1;&#xA;END;&#xA;&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM dbo.productos p&#xA;    LEFT JOIN dbo.categorias c ON c.categoria_id = p.categoria_id&#xA;    WHERE p.producto_id IS NULL&#xA;       OR p.producto_id = -1&#xA;       OR c.categoria_id IS NULL&#xA;       OR NULLIF(LTRIM(RTRIM(p.nombre)), '') IS NULL&#xA;       OR NULLIF(LTRIM(RTRIM(c.categoria)), '') IS NULL&#xA;       OR LEN(p.nombre) &gt; 100&#xA;       OR LEN(c.categoria) &gt; 100&#xA;       OR p.precio IS NULL&#xA;       OR p.precio &lt; 0&#xA;)&#xA;BEGIN&#xA;    THROW 51000, 'Producto, categoria o precio invalido; revisar origen.', 1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

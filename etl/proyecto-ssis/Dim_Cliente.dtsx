  <DTS:Executables>
    <DTS:Executable DTS:refId="Package\01 Validar origen" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{2FB12AF4-4C29-4656-A345-F2E4848737A5}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:ObjectName="01 Validar origen" DTS:DelayValidation="True" DTS:FailPackageOnFailure="True">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{30F4B38A-F396-41A4-92B9-7B3F9210A0F9}" SQLTask:SqlStatementSource="IF EXISTS(SELECT cliente_id FROM dbo.clientes GROUP BY cliente_id HAVING COUNT(*)&gt;1)&#10; THROW 51000,'Cliente duplicado en origen.',1;&#10;IF EXISTS(SELECT 1 FROM dbo.clientes e WHERE e.cliente_id IS NULL OR e.cliente_id=-1&#10; OR NULLIF(LTRIM(RTRIM(e.nombre)),N'') IS NULL OR NULLIF(LTRIM(RTRIM(e.appaterno)),N'') IS NULL&#10; OR LEN(LTRIM(RTRIM(COALESCE(e.nombre,N'')))+N' '+LTRIM(RTRIM(COALESCE(e.appaterno,N'')))+CASE WHEN NULLIF(LTRIM(RTRIM(e.apmaterno)),N'') IS NULL THEN N'' ELSE N' '+LTRIM(RTRIM(e.apmaterno)) END)&gt;150 OR LEN(e.estado_civil)&gt;50)&#10; THROW 51000,'Cliente o textos fuera de los limites del destino.',1;" SQLTask:BypassPrepare="True" SQLTask:ResultType="ResultSetType_None" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\03 Cargar Dim_Cliente" DTS:CreationName="Microsoft.Pipeline" DTS:DTSID="{342B31EC-845A-4E8C-9A22-1C9877CDE1E5}" DTS:ExecutableType="Microsoft.Pipeline" DTS:ObjectName="03 Cargar Dim_Cliente" DTS:DelayValidation="True" DTS:FailPackageOnFailure="True">

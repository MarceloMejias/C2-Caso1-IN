                        <property name="FriendlyExpression" dataType="System.String">(DT_WSTR,20)(ISNULL(Sexo_Origen) ? "No Informado" : (UPPER(TRIM(Sexo_Origen)) == "M" ? "Masculino" : (UPPER(TRIM(Sexo_Origen)) == "F" ? "Femenino" : "No Informado")))</property>

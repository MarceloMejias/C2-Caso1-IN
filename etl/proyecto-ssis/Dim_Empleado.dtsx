    <DTS:Executable DTS:refId="Package\01 Validar origen" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{1EF1704F-779F-4DDD-AD67-3CAD32AF5A93}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:ObjectName="01 Validar origen" DTS:DelayValidation="True" DTS:FailPackageOnFailure="True">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{15C72740-96E3-49CF-9D39-69D406D8F1FC}" SQLTask:SqlStatementSource="IF EXISTS(SELECT empleado_id FROM dbo.empleados GROUP BY empleado_id HAVING COUNT(*)&gt;1)&#10; THROW 51000,'Empleado duplicado en origen.',1;&#10;IF EXISTS(SELECT 1 FROM dbo.empleados e LEFT JOIN dbo.cargos c ON c.cargo_id=e.cargo_id&#10; WHERE e.empleado_id IS NULL OR e.empleado_id=-1 OR c.cargo_id IS NULL&#10; OR NULLIF(LTRIM(RTRIM(e.nombre)),N'') IS NULL OR NULLIF(LTRIM(RTRIM(e.appaterno)),N'') IS NULL&#10; OR LEN(LTRIM(RTRIM(COALESCE(e.nombre,N'')))+N' '+LTRIM(RTRIM(COALESCE(e.appaterno,N'')))+CASE WHEN NULLIF(LTRIM(RTRIM(e.apmaterno)),N'') IS NULL THEN N'' ELSE N' '+LTRIM(RTRIM(e.apmaterno)) END)&gt;150 OR NULLIF(LTRIM(RTRIM(c.nombre)),N'') IS NULL&#10; OR LEN(UPPER(LTRIM(RTRIM(c.nombre))))&gt;100 OR e.sueldo_base&lt;0)&#10; THROW 51000,'Empleado, nombre completo, cargo o sueldo invalido.',1;" SQLTask:BypassPrepare="True" SQLTask:ResultType="ResultSetType_None" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\03 Cargar Dim_Empleado" DTS:CreationName="Microsoft.Pipeline" DTS:DTSID="{493FB6EC-CD10-48B7-A7D2-4010D818D052}" DTS:ExecutableType="Microsoft.Pipeline" DTS:ObjectName="03 Cargar Dim_Empleado" DTS:DelayValidation="True" DTS:FailPackageOnFailure="True">

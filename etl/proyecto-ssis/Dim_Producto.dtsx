    <DTS:Executable DTS:refId="Package\01 Validar origen" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{FF7732F5-9014-4243-98F3-48826F9A43CA}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:ObjectName="01 Validar origen" DTS:DelayValidation="True" DTS:FailPackageOnFailure="True">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{0EC50AFD-A60F-4662-B212-16F4A3BEEF2C}" SQLTask:SqlStatementSource="IF EXISTS(SELECT producto_id FROM dbo.productos GROUP BY producto_id HAVING COUNT(*)&gt;1)&#10; THROW 51000,'Producto duplicado en origen.',1;&#10;IF EXISTS(SELECT 1 FROM dbo.productos p LEFT JOIN dbo.categorias c ON c.categoria_id=p.categoria_id&#10; WHERE p.producto_id IS NULL OR p.producto_id=-1 OR c.categoria_id IS NULL&#10; OR NULLIF(LTRIM(RTRIM(p.nombre)),'') IS NULL OR NULLIF(LTRIM(RTRIM(c.categoria)),'') IS NULL&#10; OR LEN(p.nombre)&gt;100 OR LEN(c.categoria)&gt;100 OR p.precio IS NULL OR p.precio&lt;0)&#10; THROW 51000,'Producto, categoria o precio invalido; revisar origen.',1;" SQLTask:BypassPrepare="True" SQLTask:ResultType="ResultSetType_None" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\02 Cargar productos" DTS:CreationName="Microsoft.Pipeline" DTS:DTSID="{56F5AAD0-146F-4B1A-8751-7BACE2DBDFB2}" DTS:ExecutableType="Microsoft.Pipeline" DTS:ObjectName="02 Cargar productos" DTS:DelayValidation="True" DTS:FailPackageOnFailure="True">

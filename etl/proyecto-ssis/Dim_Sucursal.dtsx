          <components>
            <component refId="Package\02 Cargar sucursales\Sucursales y comunas" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7" description="OLE DB Source" name="Sucursales y comunas" usesDispositions="true" version="7" validateExternalMetadata="False">
              <properties>
                <property dataType="System.Int32" description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out." name="CommandTimeout">0</property>
                <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset" />
                <property dataType="System.String" description="Specifies the variable that contains the name of the database object used to open a rowset." name="OpenRowsetVariable" />
                <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand" UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT s.sucursal_id AS Sucursal_BK,
 CAST(LTRIM(RTRIM(s.sucursal)) AS varchar(100)) AS Nombre_Sucursal,
 CAST(LTRIM(RTRIM(c.comuna)) AS varchar(100)) AS Nombre_Comuna
FROM dbo.sucursales AS s
INNER JOIN dbo.comunas AS c ON c.comuna_id=s.comuna_id
WHERE NOT EXISTS(SELECT 1 FROM Albarran_DW.dbo.Dim_Sucursal AS d WHERE d.Sucursal_BK=s.sucursal_id);</property>
                <property dataType="System.String" description="The variable that contains the SQL command to be executed." name="SqlCommandVariable" />
                <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable from the data source." name="DefaultCodePage">1252</property>

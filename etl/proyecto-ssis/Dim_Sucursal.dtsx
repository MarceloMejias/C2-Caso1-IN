    <DTS:Executable DTS:refId="Package\01 Validar origen" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{198ACDD6-4097-4C9B-ABDA-5B34690D32A4}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:ObjectName="01 Validar origen" DTS:DelayValidation="True" DTS:FailPackageOnFailure="True">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{F15E6C95-F903-49A5-8938-F6D63F66B2E4}" SQLTask:SqlStatementSource="IF EXISTS(SELECT sucursal_id FROM dbo.sucursales GROUP BY sucursal_id HAVING COUNT(*)&gt;1)&#10; THROW 51000,'Sucursal duplicada en origen.',1;&#10;IF EXISTS(SELECT 1 FROM dbo.sucursales s LEFT JOIN dbo.comunas c ON c.comuna_id=s.comuna_id&#10; WHERE s.sucursal_id IS NULL OR s.sucursal_id=-1 OR c.comuna_id IS NULL&#10; OR NULLIF(LTRIM(RTRIM(s.sucursal)),'') IS NULL OR NULLIF(LTRIM(RTRIM(c.comuna)),'') IS NULL&#10; OR LEN(s.sucursal)&gt;100 OR LEN(c.comuna)&gt;100)&#10; THROW 51000,'Sucursal o comuna inexistente, vacia o demasiado larga.',1;" SQLTask:BypassPrepare="True" SQLTask:ResultType="ResultSetType_None" />
      </DTS:ObjectData>
    </DTS:Executable>
